use decode
use dram
use go:fmt
use maestro/api_football/leagues
use maestro/app
use maestro/auth
use maestro/competitions
use maestro/groups
use maestro/week
use go:net/http
use go:strconv
use go:strings

struct Entry {
  user_id: Int,
  email: Str,
  display_name: Str?,
  total_points: Int,
  exact_count: Int,
  outcome_count: Int,
  played: Int,
}

fn register(router: mut dram::App, a: app::App) {
  let protected = mut router.group("/")
  protected.use(auth::middleware(a))

  protected.get("/groups/:id/leaderboard/season", fn(req: dram::Request, res: mut dram::Response) {
    let group_id = try strconv::Atoi(req.param("id").or("")) -> _ {
      res.json(http::StatusBadRequest, ["error": "group id must be an integer"])
    }
    let competition_id = try parse_competition(req) -> err { res.json(http::StatusBadRequest, ["error": err]) }
    let user_id = try auth::get_user_id(req) -> err { res.json(http::StatusUnauthorized, ["error": err]) }
    let maybe_group = try groups::find_for_member(a, group_id, user_id) -> err {
      fmt::Println("leaderboard group lookup failed for group {group_id}, user {user_id}: {err}")
      res.json(http::StatusInternalServerError, ["error": "could not load group"])
    }
    let _ = try maybe_group -> _ { res.json(http::StatusNotFound, ["error": "group not found"]) }

    match season(a, group_id, competition_id) {
      ok(entries) => res.json(http::StatusOK, entries_json(entries)),
      err(message) => {
        fmt::Println("season leaderboard failed for group {group_id}: {message}")
        res.json(http::StatusInternalServerError, ["error": "could not load leaderboard"])
      },
    }
  })

  protected.get("/groups/:id/leaderboard/week", fn(req: dram::Request, res: mut dram::Response) {
    let group_id = try strconv::Atoi(req.param("id").or("")) -> _ {
      res.json(http::StatusBadRequest, ["error": "group id must be an integer"])
    }
    let competition_id = try parse_competition(req) -> err { res.json(http::StatusBadRequest, ["error": err]) }
    let bounds = try week::current(req.query("week").or("")) -> err {
      res.json(http::StatusBadRequest, ["error": err])
    }
    let user_id = try auth::get_user_id(req) -> err { res.json(http::StatusUnauthorized, ["error": err]) }
    let maybe_group = try groups::find_for_member(a, group_id, user_id) -> err {
      fmt::Println("leaderboard group lookup failed for group {group_id}, user {user_id}: {err}")
      res.json(http::StatusInternalServerError, ["error": "could not load group"])
    }
    let _ = try maybe_group -> _ { res.json(http::StatusNotFound, ["error": "group not found"]) }

    match weekly(a, group_id, competition_id, bounds) {
      ok(entries) => res.json(http::StatusOK, entries_json(entries)),
      err(message) => {
        fmt::Println("weekly leaderboard failed for group {group_id}: {message}")
        res.json(http::StatusInternalServerError, ["error": "could not load leaderboard"])
      },
    }
  })
}

fn season(a: app::App, group_id: Int, competition_id: Int?) [Entry]!Str {
  aggregate(a, group_id, competition_id, Int64::from(0), Int64::from(0), false)
}

fn weekly(a: app::App, group_id: Int, competition_id: Int?, bounds: week::Bounds) [Entry]!Str {
  aggregate(a, group_id, competition_id, bounds.start_ms, bounds.end_ms, true)
}

private fn aggregate(
  a: app::App,
  group_id: Int,
  competition_id: Int?,
  start_ms: Int64,
  end_ms: Int64,
  bounded: Bool,
) [Entry]!Str {
  let competition_filter = match competition_id {
    value => value,
    _ => 0,
  }
  let bounded_int = match bounded {
    true => 1,
    false => 0,
  }
  // Grouped by (user, competition, season); the season slice is applied in
  // Ard because "current season" is resolved from the provider per league.
  let rows = try a.db.query(
    "SELECT u.id AS user_id, u.email, u.display_name, s.competition_id AS competition_id, s.season AS season, COALESCE(SUM(CASE WHEN s.state = 'settled' AND (@competition_id = 0 OR s.competition_id = @competition_id) AND (@bounded = 0 OR (s.kickoff_at >= @start_ms AND s.kickoff_at < @end_ms)) THEN p.points ELSE 0 END), 0) AS total_points, COALESCE(SUM(CASE WHEN s.state = 'settled' AND (@competition_id = 0 OR s.competition_id = @competition_id) AND (@bounded = 0 OR (s.kickoff_at >= @start_ms AND s.kickoff_at < @end_ms)) AND p.points = 3 THEN 1 ELSE 0 END), 0) AS exact_count, COALESCE(SUM(CASE WHEN s.state = 'settled' AND (@competition_id = 0 OR s.competition_id = @competition_id) AND (@bounded = 0 OR (s.kickoff_at >= @start_ms AND s.kickoff_at < @end_ms)) AND p.points = 1 THEN 1 ELSE 0 END), 0) AS outcome_count, COALESCE(SUM(CASE WHEN s.state = 'settled' AND (@competition_id = 0 OR s.competition_id = @competition_id) AND (@bounded = 0 OR (s.kickoff_at >= @start_ms AND s.kickoff_at < @end_ms)) AND p.points IS NOT NULL THEN 1 ELSE 0 END), 0) AS played FROM group_members gm JOIN users u ON u.id = gm.user_id LEFT JOIN predictions p ON p.user_id = gm.user_id LEFT JOIN fixture_scoring_state s ON s.fixture_id = p.fixture_id WHERE gm.group_id = @group_id GROUP BY u.id, u.email, u.display_name, s.competition_id, s.season",
  ).all(
    [
      "group_id": group_id,
      "competition_id": competition_filter,
      "bounded": bounded_int,
      "start_ms": start_ms,
      "end_ms": end_ms,
    ],
  )
  let current_seasons = current_season_by_competition(a)
  let combined = try combine_rows(rows, bounded, current_seasons)
  Result::ok(sort_entries(combined))
}

// Current season year per competition id, best-effort: a failed provider
// lookup just excludes that competition from season-mode standings.
private fn current_season_by_competition(a: app::App) [Str: Int] {
  let out: mut [Str: Int] = mut [:]
  match competitions::list_all(a) {
    err(message) => fmt::Println("leaderboard competition list failed: {message}"),
    ok(comps) => {
      for comp in comps {
        match leagues::current_season(a, comp.api_football_league_id) {
          ok(season) => out.set("{comp.id}", season.year),
          err(message) => {
            fmt::Println("leaderboard season lookup failed for competition {comp.id}: {message}")
          },
        }
      }
    },
  }
  deref out
}

// Merge grouped rows into one entry per member. Season mode (unbounded)
// keeps only each competition's current season; weekly mode is already
// time-bounded, so every row counts. Rows with no scoring state (members
// without settled predictions) pass through so everyone appears.
private fn combine_rows(rows: [Any], bounded: Bool, current_seasons: [Str: Int]) [Entry]!Str {
  mut entries: mut [Entry] = mut []
  for row in rows {
    let slice = try decode_entry(row)
    let competition_id = try decode::run(row, decode::field("competition_id", decode::nullable(decode::int))).map_err(describe)
    let season = try decode::run(row, decode::field("season", decode::nullable(decode::int))).map_err(describe)
    let include = match bounded {
      true => true,
      false => in_current_season(competition_id, season, current_seasons),
    }
    mut merged = false
    let updated: mut [Entry] = mut []
    for existing in entries {
      match existing.user_id == slice.user_id {
        true => {
          merged = true
          match include {
            true => updated.push(add_entries(existing, slice)),
            false => updated.push(existing),
          }
        },
        false => updated.push(existing),
      }
    }
    match merged {
      true => (),
      false => {
        match include {
          true => updated.push(slice),
          false => updated.push(zeroed(slice)),
        }
      },
    }
    entries = updated
  }
  Result::ok(deref entries)
}

private fn in_current_season(competition_id: Int?, season: Int?, current_seasons: [Str: Int]) Bool {
  match competition_id {
    // No scoring state at all: a zero row that only keeps the member listed.
    comp_id => {
      match season {
        // Pre-season-column history has no recorded season; count it so
        // legacy points don't vanish.
        year => {
          match current_seasons.get("{comp_id}") {
            // Season lookup unavailable (provider outage): fail open so
            // standings degrade to combined-history rather than zeros.
            current => current == year,
            _ => true,
          }
        },
        _ => true,
      }
    },
    _ => false,
  }
}

private fn add_entries(base: Entry, slice: Entry) Entry {
  Entry{
    user_id: base.user_id,
    email: base.email,
    display_name: base.display_name,
    total_points: base.total_points + slice.total_points,
    exact_count: base.exact_count + slice.exact_count,
    outcome_count: base.outcome_count + slice.outcome_count,
    played: base.played + slice.played,
  }
}

private fn zeroed(slice: Entry) Entry {
  Entry{
    user_id: slice.user_id,
    email: slice.email,
    display_name: slice.display_name,
    total_points: 0,
    exact_count: 0,
    outcome_count: 0,
    played: 0,
  }
}

// Insertion sort by the leaderboard ordering: points desc, exact desc,
// outcome desc, then display name/email, then id.
private fn sort_entries(entries: [Entry]) [Entry] {
  mut out: mut [Entry] = mut []
  for entry in entries {
    mut inserted = false
    let result: mut [Entry] = mut []
    for existing in deref out {
      let goes_before = (not inserted) and ranks_before(entry, existing)
      match goes_before {
        true => {
          result.push(entry)
          inserted = true
        },
        false => (),
      }
      result.push(existing)
    }
    match inserted {
      true => (),
      false => result.push(entry),
    }
    out = result
  }
  deref out
}

private fn ranks_before(a: Entry, b: Entry) Bool {
  match {
    a.total_points != b.total_points => a.total_points > b.total_points,
    a.exact_count != b.exact_count => a.exact_count > b.exact_count,
    a.outcome_count != b.outcome_count => a.outcome_count > b.outcome_count,
    display_key(a) != display_key(b) => strings::Compare(display_key(a), display_key(b)) < 0,
    _ => a.user_id < b.user_id,
  }
}

private fn display_key(entry: Entry) Str {
  match entry.display_name {
    name => name,
    _ => entry.email,
  }
}

private fn entries_json(entries: [Entry]) [Any] {
  let payload: mut [Any] = mut []
  mut position = 0
  mut rank = 0
  mut previous: Entry? = Maybe::new()
  for entry in entries {
    position = position + 1
    match previous {
      prior => {
        match same_score(prior, entry) {
          true => (),
          false => { rank = position },
        }
      },
      _ => { rank = position },
    }
    payload.push(entry_json(entry, rank))
    previous = Maybe::new(entry)
  }
  deref payload
}

private fn same_score(a: Entry, b: Entry) Bool {
  a.total_points == b.total_points and a.exact_count == b.exact_count and a.outcome_count == b.outcome_count
}

private fn entry_json(entry: Entry, rank: Int) [Str: Any] {
  let user: [Str: Any] = [
    "id": entry.user_id,
    "email": entry.email,
    "display_name": entry.display_name,
  ]

  let payload: [Str: Any] = [
    "rank": rank,
    "user": user,
    "total_points": entry.total_points,
    "exact_count": entry.exact_count,
    "outcome_count": entry.outcome_count,
    "played": entry.played,
  ]

  payload
}

private fn decode_entry(row: Any) Entry!Str {
  let user_id = try int_field(row, "user_id")
  let email = try decode::run(row, decode::field("email", decode::string)).map_err(describe)
  let display_name = try decode::run(row, decode::field("display_name", decode::nullable(decode::string))).map_err(describe)
  let total_points = try int_field(row, "total_points")
  let exact_count = try int_field(row, "exact_count")
  let outcome_count = try int_field(row, "outcome_count")
  let played = try int_field(row, "played")
  Result::ok(
    Entry{
      user_id: user_id,
      email: email,
      display_name: display_name,
      total_points: total_points,
      exact_count: exact_count,
      outcome_count: outcome_count,
      played: played,
    },
  )
}

private fn parse_competition(req: dram::Request) Int?!Str {
  let raw = req.query("competition_id").or("")
  match raw.is_empty() {
    true => Result::ok(Maybe::new()),
    false => {
      match strconv::Atoi(raw) {
        ok(value) => Result::ok(Maybe::new(value)),
        err(_) => Result::err("competition_id must be an integer"),
      }
    },
  }
}

private fn int_field(row: Any, name: Str) Int!Str {
  decode::run(row, decode::field(name, decode::int)).map_err(describe)
}

private fn describe(e: decode::Err) Str {
  e.to_str()
}
