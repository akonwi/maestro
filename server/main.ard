use ard/async

use go:errors
use go:fmt
use maestro/app
use maestro/config
use go:maestro/ffi
use maestro/maintenance_worker
use maestro/router
use maestro/scoring_worker
use go:net/http
use go:os
use go:os/signal
use sql
use go:strings
use go:syscall
use go:time

fn main() {
  let cfg = config::load().expect("config error")
  
  let sqlite_url = match strings::Contains(cfg.database_url, "?") {
    true => "{cfg.database_url}&_pragma=foreign_keys(1)",
    false => "{cfg.database_url}?_pragma=foreign_keys(1)",
  }
  let db = sql::open(sqlite_url).expect("failed to open database at {cfg.database_url}")
  db.exec("PRAGMA foreign_keys = ON;").expect("failed to enable SQLite foreign keys")
  fmt::Println("database ready at {cfg.database_url}")
  
  let application = app::App{
    db: db,
    config: cfg,
    cache: ffi::NewCache(),
  }
  
  let maintenance = maintenance_worker::start(application)
  let scoring = scoring_worker::start(application)
  let server = mut http::Server{Addr: cfg.listen_addr, Handler: router::build(application)}
  
  let interrupts = Chan::new<os::Signal>(1)
  signal::Notify(interrupts.sender(), syscall::SIGINT)
  signal::Notify(interrupts.sender(), syscall::SIGTERM)
  
  async::start(fn() {
    try server.ListenAndServe() -> err {
      match errors::Is(err, http::ErrServerClosed) {
        true => (),
        false => panic("Server error: {err}"),
      }
    }
  })
  fmt::Println("listening on {cfg.listen_addr}")
  
  interrupts.recv()
  
  fmt::Println("shutting down")
  maintenance_worker::request_stop(maintenance)
  scoring_worker::request_stop(scoring)
  match ffi::ShutdownServer(server, 10 * time::Second) {
    ok => (),
    err(message) => fmt::Println("HTTP shutdown failed: {message}"),
  }
  match maintenance_worker::await_shutdown(maintenance, 5 * time::Second) {
    true => (),
    false => fmt::Println("maintenance worker shutdown timed out"),
  }
  match scoring_worker::await_shutdown(scoring, 5 * time::Second) {
    true => (),
    false => fmt::Println("scoring worker shutdown timed out"),
  }
  fmt::Println("goodbye")
}
