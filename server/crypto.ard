use go:bytes
use go:crypto/rand
use go:encoding/hex
use go:fmt
use go:math/big

private fn error_message(error: Error) Str {
  error.error()
}

// Cryptographic helpers. Small enough to stay one file.

// Return a URL-safe hex token backed by `n` bytes of crypto/rand
// entropy. The returned string is `2 * n` characters long.
fn generate_token(n: Int) Str!Str {
  // Allocate a zero-filled byte buffer of length n. Ard has no `make`
  // equivalent; bytes.Repeat is the idiomatic path.
  mut seed: [Byte] = [0]
  mut buf = bytes::Repeat(mut seed, n)
  try rand::Read(mut buf).map_err(error_message)
  Result::ok(hex::EncodeToString(mut buf))
}

fn generate_numeric_code() Str!Str {
  let number = try rand::Int(rand::Reader, big::NewInt(1_000_000)).map_err(error_message)
  Result::ok(fmt::Sprintf("%06d", number.Int64()))
}
