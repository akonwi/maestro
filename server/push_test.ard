use ard/testing

use maestro/push
use maestro/test_helpers
use maestro/users

test fn save_upserts_by_endpoint() Void!Str {
  let app = try test_helpers::build_app()
  let ada = try users::get_or_create_by_email(app, "ada@example.com")
  let grace = try users::get_or_create_by_email(app, "grace@example.com")

  let sub = push::Subscription{
    endpoint: "https://push.example/abc",
    p256dh: "k1",
    auth: "a1",
  }
  try push::save(app, ada.id, sub)
  // Same endpoint re-registered by another account takes it over.
  let taken = push::Subscription{
    endpoint: "https://push.example/abc",
    p256dh: "k2",
    auth: "a2",
  }
  try push::save(app, grace.id, taken)

  let rows = try app.db.query("SELECT user_id, p256dh FROM push_subscriptions").all([:])
  try testing::assert(rows.size() == 1, "one row per endpoint, got {rows.size()}")
  testing::pass()
}

test fn remove_only_deletes_own_subscription() Void!Str {
  let app = try test_helpers::build_app()
  let ada = try users::get_or_create_by_email(app, "ada@example.com")
  let grace = try users::get_or_create_by_email(app, "grace@example.com")

  try push::save(
    app,
    ada.id,
    push::Subscription{
      endpoint: "https://push.example/ada",
      p256dh: "k",
      auth: "a",
    },
  )

  // Someone else cannot remove Ada's subscription.
  try push::remove(app, grace.id, "https://push.example/ada")
  let after_other = try app.db.query("SELECT endpoint FROM push_subscriptions").all([:])
  try testing::assert(after_other.size() == 1, "other user's delete is a no-op")

  try push::remove(app, ada.id, "https://push.example/ada")
  let after_own = try app.db.query("SELECT endpoint FROM push_subscriptions").all([:])
  try testing::assert(after_own.size() == 0, "owner's delete removes the row")
  testing::pass()
}

test fn targets_join_settled_predictions_with_subscriptions() Void!Str {
  let app = try test_helpers::build_app()
  let ada = try users::get_or_create_by_email(app, "ada@example.com")
  let grace = try users::get_or_create_by_email(app, "grace@example.com")

  // Ada predicted and is subscribed; Grace predicted but has no
  // subscription; a third prediction is unsettled (points NULL).
  try push::save(
    app,
    ada.id,
    push::Subscription{
      endpoint: "https://push.example/ada",
      p256dh: "k",
      auth: "a",
    },
  )
  try app.db.query(
    "INSERT INTO predictions (user_id, fixture_id, home_score, away_score, points, created_at, updated_at) VALUES (@user, 500, 2, 1, 3, 0, 0)",
  ).run(["user": ada.id])
  try app.db.query(
    "INSERT INTO predictions (user_id, fixture_id, home_score, away_score, points, created_at, updated_at) VALUES (@user, 500, 1, 1, 0, 0, 0)",
  ).run(["user": grace.id])
  try app.db.query(
    "INSERT INTO predictions (user_id, fixture_id, home_score, away_score, points, created_at, updated_at) VALUES (@user, 501, 2, 0, NULL, 0, 0)",
  ).run(["user": ada.id])

  let targets = try push::targets_for_fixture(app, 500)
  try testing::assert(
    targets.size() == 1,
    "only subscribed users with settled predictions, got {targets.size()}",
  )
  let target = targets.at(0).expect("target")
  try testing::assert(target.user_id == ada.id, "target is ada")
  try testing::assert(target.points == 3, "carries the settled points")
  try testing::assert(target.predicted_home == 2 and target.predicted_away == 1, "carries the pick")
  testing::pass()
}

test fn result_body_reflects_points() Void!Str {
  try testing::assert(push::result_body(2, 1, 3) == "Exact score! +3 points", "exact score copy")
  try testing::assert(
    push::result_body(1, 0, 1) == "Right outcome - you predicted 1-0. +1 point",
    "outcome copy",
  )
  try testing::assert(push::result_body(0, 2, 0) == "You picked 0-2", "no points copy")
  testing::pass()
}
