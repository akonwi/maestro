use decode
use maestro/app

// Store for the competitions table: one row per league we track, for the
// lifetime of the app. The *current season* is not part of a
// competition's identity — it's resolved at runtime from API-Football
// (see api_football/leagues), so season rollovers require no data
// changes and competition ids stay stable forever.

struct Competition {
  id: Int,
  api_football_league_id: Int,
  name: Str,
  kind: Str,
  // 'league' | 'cup' | 'playoff'
  is_active: Bool,
}

fn list_active(a: app::App) [Competition]!Str {
  let rows = try a.db.query(
    "SELECT id, api_football_league_id, name, kind, is_active FROM competitions WHERE is_active = 1",
  ).all([:])
  decode_all(rows)
}

fn list_all(a: app::App) [Competition]!Str {
  let rows = try a.db.query(
    "SELECT id, api_football_league_id, name, kind, is_active FROM competitions ORDER BY id",
  ).all([:])
  decode_all(rows)
}

// Insert or update a competition keyed by provider league id.
// Deactivation is the same upsert with is_active false.
fn upsert(a: app::App, league_id: Int, name: Str, kind: Str, is_active: Bool) Competition!Str {
  let active_int = match is_active {
    true => 1,
    false => 0,
  }
  try a.db.query(
    "INSERT INTO competitions (api_football_league_id, name, kind, is_active) VALUES (@league_id, @name, @kind, @is_active) ON CONFLICT(api_football_league_id) DO UPDATE SET name = @name, kind = @kind, is_active = @is_active",
  ).run(["league_id": league_id, "name": name, "kind": kind, "is_active": active_int])
  let row = try a.db.query(
    "SELECT id, api_football_league_id, name, kind, is_active FROM competitions WHERE api_football_league_id = @league_id LIMIT 1",
  ).first(["league_id": league_id])
  match row {
    value => decode_competition(value),
    _ => Result::err("competition upsert did not persist"),
  }
}

// Resolve a league id to its competition, regardless of activation —
// used to attribute fixtures (including archived seasons).
fn find_by_league(a: app::App, league_id: Int) Competition?!Str {
  let row = try a.db.query(
    "SELECT id, api_football_league_id, name, kind, is_active FROM competitions WHERE api_football_league_id = @league_id LIMIT 1",
  ).first(["league_id": league_id])
  match row {
    value => Result::ok(Maybe::new(try decode_competition(value))),
    _ => Result::ok(Maybe::new()),
  }
}

private fn decode_all(rows: [Any]) [Competition]!Str {
  let out: mut [Competition] = mut []
  for row in rows {
    let comp = try decode_competition(row)
    out.push(comp)
  }
  Result::ok(out.@)
}

private fn decode_competition(row: Any) Competition!Str {
  let id = try decode::run(row, decode::field("id", decode::int)).map_err(describe)
  let league_id = try decode::run(row, decode::field("api_football_league_id", decode::int)).map_err(describe)
  let name = try decode::run(row, decode::field("name", decode::string)).map_err(describe)
  let kind = try decode::run(row, decode::field("kind", decode::string)).map_err(describe)
  let is_active_int = try decode::run(row, decode::field("is_active", decode::int)).map_err(describe)
  Result::ok(
    Competition{
      id: id,
      api_football_league_id: league_id,
      name: name,
      kind: kind,
      is_active: is_active_int == 1,
    },
  )
}

private fn describe(e: decode::Err) Str {
  "decoding competition row: {e.to_str()}"
}
