use decode
use maestro/app
use maestro/crypto
use sql
use go:time

// A one-shot email->token record used to bootstrap sessions.

// Mint a new magic link for `email`. Returns the token to embed in the
// verification URL.
fn create(a: app::App, email: Str) Str!Str {
  let token = try crypto::generate_token(32)
  let now = time::Now().UnixMilli()
  let ttl_ms = Int64::from(900 * 1000)
  let expires_at = now + ttl_ms

  try a.db.query(
    "INSERT INTO magic_links (token, email, expires_at) VALUES (@token, @email, @expires_at)",
  ).run(["token": token, "email": email, "expires_at": expires_at])
  Result::ok(token)
}

// Single-use redemption. The conditional update is the claim: even concurrent
// requests cannot both receive the email for one token.
fn consume(a: app::App, token: Str) Str!Str {
  let tx = try a.db.begin()
  match consume_tx(tx, token) {
    ok(email) => {
      match tx.commit() {
        ok => Result::ok(email),
        err(message) => Result::err("committing magic link consumption: {message}"),
      }
    },
    err(message) => {
      match tx.rollback() {
        ok => Result::err(message),
        err(rollback_message) => Result::err("{message}; rollback failed: {rollback_message}"),
      }
    },
  }
}

fn consume_tx(tx: sql::Transaction, token: Str) Str!Str {
  let now = time::Now().UnixMilli()
  let rows = try tx.query(
    "UPDATE magic_links SET consumed_at = @now WHERE token = @token AND consumed_at IS NULL AND expires_at > @now RETURNING email",
  ).all(["now": now, "token": token])
  match rows.at(0) {
    row => decode::run(row, decode::field("email", decode::string)).map_err(describe),
    _ => describe_unclaimable(tx, token, now),
  }
}

fn delete_stale_at(a: app::App, now: Int64, consumed_before: Int64) Void!Str {
  a.db.query(
    "DELETE FROM magic_links WHERE expires_at <= @now OR (consumed_at IS NOT NULL AND consumed_at <= @consumed_before)",
  ).run(["now": now, "consumed_before": consumed_before])
}

private fn describe_unclaimable(tx: sql::Transaction, token: Str, now: Int64) Str!Str {
  let rows = try tx.query(
    "SELECT expires_at, consumed_at FROM magic_links WHERE token = @token LIMIT 1",
  ).all(["token": token])
  match rows.at(0) {
    row => {
      let expires_at = try decode::run(row, decode::field("expires_at", decode::int)).map_err(describe)
      let consumed_at = try decode::run(row, decode::field("consumed_at", decode::nullable(decode::int))).map_err(describe)
      match consumed_at.is_some() {
        true => Result::err("magic link already used"),
        false => {
          match Int64::from(expires_at) <= now {
            true => Result::err("magic link expired"),
            false => Result::err("magic link could not be consumed"),
          }
        },
      }
    },
    _ => Result::err("invalid or unknown magic link"),
  }
}

private fn describe(e: decode::Err) Str {
  "decoding magic_link row: {e.to_str()}"
}
