use dram
use go:fmt
use maestro/api_football/prematch
use maestro/app
use maestro/competitions
use go:net/http
use go:strconv

// Public league table: a read-only proxy over API-Football standings,
// grouped by conference. Rides the shared TTL cache in api_football.

fn register(router: mut dram::App, a: app::App) {
  router.get("/standings", fn(req: dram::Request, res: mut dram::Response) {
    let raw = req.query("competition_id").or("")
    let competition_id: Int? = match raw == "" {
      true => Maybe::new(),
      false => {
        match strconv::Atoi(raw) {
          ok(id) => Maybe::new(id),
          err(_) => Maybe::new(),
        }
      },
    }
    match standings_payload(a, competition_id) {
      ok(payload) => res.json(http::StatusOK, payload),
      err(message) => {
        fmt::Println("standings request failed: {message}")
        res.json(http::StatusBadGateway, ["error": "standings are temporarily unavailable"])
      },
    }
  })
}

fn standings_payload(a: app::App, competition_id: Int?) [Str: Any]!Str {
  let comps = try competitions::list_active(a)
  mut chosen: competitions::Competition? = Maybe::new()
  for comp in comps {
    let wanted = match competition_id {
      id => id == comp.id,
      _ => chosen.is_none(),
    }
    if wanted {
      chosen = Maybe::new(comp)
    }
  }

  match chosen {
    comp => {
      let rows = try prematch::league_standings(a, comp.api_football_league_id, comp.season)
      let payload: [Str: Any] = [
        "competition_id": comp.id,
        "season": comp.season,
        "conferences": group_conferences(rows),
      ]

      Result::ok(payload)
    },
    _ => {
      let empty: [Any] = []
      let no_comp: Int? = Maybe::new()
      let payload: [Str: Any] = ["competition_id": no_comp, "season": 0, "conferences": empty]
      Result::ok(payload)
    },
  }
}

// Group rows into conferences in first-appearance order, preserving the
// upstream (rank) order within each.
fn group_conferences(rows: [prematch::StandingRow]) [Any] {
  let names: mut [Str] = mut []
  for row in rows {
    mut seen = false
    for n in names {
      if n == row.group {
        seen = true
      }
    }
    if not seen {
      names.push(row.group)
    }
  }

  let conferences: mut [Any] = mut []
  for name in names {
    let group_rows: mut [Any] = mut []
    for row in rows {
      if row.group == name {
        group_rows.push(standing_json(row))
      }
    }
    let conference: [Str: Any] = ["name": name, "rows": group_rows]
    conferences.push(conference)
  }
  deref conferences
}

private fn standing_json(row: prematch::StandingRow) [Str: Any] {
  let payload: [Str: Any] = [
    "rank": row.rank,
    "team_id": row.team_id,
    "team_name": row.team_name,
    "played": row.played,
    "win": row.win,
    "draw": row.draw,
    "lose": row.lose,
    "goals_for": row.goals_for,
    "goals_against": row.goals_against,
    "goals_diff": row.goals_diff,
    "points": row.points,
    "form": row.form,
    "description": row.description,
  ]

  payload
}
