use ard/unsafe

use decode
use dram
use dram/context
use go:fmt
use maestro/app
use maestro/email
use maestro/login_attempts
use maestro/magic_links
use maestro/sessions
use maestro/users
use go:net/http
use sql
use go:strings

fn set_error(res: mut dram::Response, err: Str) {
  res.json(http::StatusBadRequest, ["error": err])
}

// Wire public auth endpoints and the middleware-protected current-user route.
fn register(router: mut dram::App, a: app::App) {
  router.post("/auth/request", fn(req: dram::Request, res: mut dram::Response) {
    let raw_address = try decode_field(req, "email") -> err { set_error(res, err) }
    let address = users::normalize_email(raw_address)
    match request_login(a, address) {
      ok(attempt) => {
        let payload: [Str: Any] = [
          "attempt_id": attempt.id,
          "claim_token": attempt.claim_token,
          "expires_in": 900,
        ]
        res.json(http::StatusOK, payload)
      },
      err(message) => {
        fmt::Println("login request failed for {address}: {message}")
        res.json(http::StatusInternalServerError, ["error": "could not request sign-in link"])
      },
    }
  })
  // GET /auth/verify?token=X -> 302 to the web app. Never consumes.
  router.get("/auth/verify", fn(req: dram::Request, res: mut dram::Response) {
    let token = req.query("token").or("")
    match token.is_empty() {
      true => res.json(http::StatusBadRequest, ["error": "missing token"]),
      false => {
        let target = "{a.config.app_base_url}/auth/verify?token={token}"
        res.headers.set("Location", target)
        res.status = http::StatusFound
      },
    }
  })
  router.post("/auth/verify", fn(req: dram::Request, res: mut dram::Response) {
    let token = try decode_field(req, "token") -> err { set_error(res, err) }
    match verify(a, token) {
      ok(payload) => res.json(http::StatusOK, payload),
      err(message) => {
        match is_magic_link_error(message) {
          true => set_error(res, "sign-in link is invalid or expired"),
          false => {
            fmt::Println("auth verification failed: {message}")
            res.json(http::StatusInternalServerError, ["error": "could not verify sign-in link"])
          },
        }
      },
    }
  })
  router.post("/auth/attempt/claim", fn(req: dram::Request, res: mut dram::Response) {
    let id = try decode_field(req, "attempt_id") -> err { set_error(res, err) }
    let claim_token = try decode_field(req, "claim_token") -> err { set_error(res, err) }
    match claim_attempt(a, id, claim_token) {
      ok(result) => {
        match result.complete {
          true => res.json(http::StatusOK, result.payload),
          false => res.json(http::StatusAccepted, result.payload),
        }
      },
      err(message) => {
        match is_login_attempt_error(message) {
          true => set_error(res, "login attempt is invalid or expired"),
          false => {
            fmt::Println("login-attempt claim failed: {message}")
            res.json(http::StatusInternalServerError, ["error": "could not complete sign-in"])
          },
        }
      },
    }
  })
  router.post("/auth/attempt/code", fn(req: dram::Request, res: mut dram::Response) {
    let id = try decode_field(req, "attempt_id") -> err { set_error(res, err) }
    let claim_token = try decode_field(req, "claim_token") -> err { set_error(res, err) }
    let code = try decode_field(req, "code") -> err { set_error(res, err) }
    match redeem_code(a, id, claim_token, code) {
      ok(result) => res.json(http::StatusOK, result.payload),
      err(message) => {
        match is_login_attempt_error(message) or is_magic_link_error(message) {
          true => set_error(res, "verification code is invalid or expired"),
          false => {
            fmt::Println("login code redemption failed: {message}")
            res.json(http::StatusInternalServerError, ["error": "could not verify sign-in code"])
          },
        }
      },
    }
  })
  router.post("/auth/logout", fn(req: dram::Request, res: mut dram::Response) {
    let token = bearer_token(req)
    match token.is_empty() {
      true => res.json(http::StatusUnauthorized, ["error": "missing or invalid bearer token"]),
      false => {
        match sessions::delete(a, token) {
          ok => { res.status = 204 },
          err(message) => {
            fmt::Println("session deletion failed during logout: {message}")
            res.json(http::StatusInternalServerError, ["error": "could not log out"])
          },
        }
      },
    }
  })
  
  let protected = mut router.group("/")
  protected.use(middleware(a))
  protected.get("/auth/me", fn(req: dram::Request, res: mut dram::Response) {
    match user_id(req) {
      user_id => {
        match users::find_by_id(a, user_id) {
          ok(found) => {
            match found {
              user => {
                let payload: [Str: Any] = [
                  "id": user.id,
                  "email": user.email,
                  "display_name": user.display_name,
                ]
                
                res.json(http::StatusOK, payload)
              },
              _ => res.json(http::StatusUnauthorized, ["error": "authenticated user no longer exists"]),
            }
          },
          err(message) => {
            fmt::Println("current user lookup failed for user {user_id}: {message}")
            res.json(http::StatusInternalServerError, ["error": "could not load current user"])
          },
        }
      },
      _ => res.json(http::StatusUnauthorized, ["error": "unauthorized"]),
    }
  })
}

private fn is_magic_link_error(message: Str) Bool {
  message == "magic link already used" or message == "magic link expired" or message == "invalid or unknown magic link"
}

private fn is_login_attempt_error(message: Str) Bool {
  message == login_attempts::INVALID_ATTEMPT or message == login_attempts::INVALID_CODE
}

// We deliberately never leak whether the email is known.
private fn request_login(a: app::App, address: Str) login_attempts::LoginAttempt!Str {
  let attempt = try login_attempts::create(a, address)
  let link = "{a.config.server_base_url}/auth/verify?token={attempt.magic_token}"
  let text = "Click the link to sign in to Maestro:\n\n{link}\n\nIf the link opens in your browser, return to Maestro to finish signing in. You can also enter this code in Maestro:\n\n{attempt.code}\n\nThe link and code expire soon."
  let html = "<p>Use the link below to sign in to Maestro.</p><p><a href=\"{link}\">Sign in to Maestro</a></p><p>If the link opens in your browser, return to Maestro to finish signing in.</p><p>Or enter this code in Maestro:</p><p><strong>{attempt.code}</strong></p><p>The link and code expire soon.</p>"
  
  // A send failure shouldn't leak upstream — the user can retry.
  match email::send(a.config, address, "Your Maestro sign-in link", text, html) {
    ok => Result::ok(attempt),
    err(message) => {
      fmt::Println("email send failed for {address}: {message}")
      Result::ok(attempt)
    },
  }
}

struct AttemptClaim {
  complete: Bool,
  payload: [Str: Any],
}

private fn claim_attempt(a: app::App, id: Str, claim_token: Str) AttemptClaim!Str {
  let approved = try login_attempts::find_approved(a, id, claim_token)
  match approved {
    attempt => Result::ok(completed_claim(attempt)),
    _ => Result::ok(AttemptClaim{complete: false, payload: ["status": "pending"]}),
  }
}

private fn redeem_code(a: app::App, id: Str, claim_token: Str, code: Str) AttemptClaim!Str {
  let tx = try a.db.begin()
  match redeem_code_tx(a, tx, id, claim_token, code) {
    ok(result) => {
      match tx.commit() {
        ok => Result::ok(result),
        err(message) => Result::err("committing login code redemption: {message}"),
      }
    },
    err(message) => {
      // Incorrect guesses increment code_attempts and must be committed.
      match message == login_attempts::INVALID_CODE {
        true => {
          match tx.commit() {
            ok => Result::err(message),
            err(commit_message) => Result::err("committing rejected login code: {commit_message}"),
          }
        },
        false => {
          match tx.rollback() {
            ok => Result::err(message),
            err(rollback_message) => Result::err("{message}; rollback failed: {rollback_message}"),
          }
        },
      }
    },
  }
}

private fn redeem_code_tx(a: app::App, tx: sql::Transaction, id: Str, claim_token: Str, code: Str) AttemptClaim!Str {
  let existing = try login_attempts::find_approved_tx(tx, id, claim_token)
  match existing {
    attempt => Result::ok(completed_claim(attempt)),
    _ => {
      let magic_token = try login_attempts::consume_code_tx(tx, id, claim_token, code)
      let address = try magic_links::consume_tx(tx, magic_token)
      let user = try users::get_or_create_by_email_tx(tx, address)
      let session = try sessions::mint_tx(tx, a, user.id)
      try login_attempts::attach_code_session_tx(tx, id, claim_token, session.token)
      Result::ok(
        completed_claim(
          login_attempts::ApprovedAttempt{
            session_token: session.token,
            user_id: user.id,
            email: user.email,
            display_name: user.display_name,
          },
        ),
      )
    },
  }
}

private fn completed_claim(attempt: login_attempts::ApprovedAttempt) AttemptClaim {
  let user_payload: [Str: Any] = [
    "id": attempt.user_id,
    "email": attempt.email,
    "display_name": attempt.display_name,
  ]
  AttemptClaim{
    complete: true,
    payload: ["status": "complete", "session_token": attempt.session_token, "user": user_payload],
  }
}

fn verify(a: app::App, token: Str) [Str: Any]!Str {
  let tx = try a.db.begin()
  match verify_tx(a, tx, token) {
    ok(payload) => {
      match tx.commit() {
        ok => Result::ok(payload),
        err(message) => Result::err("committing verification: {message}"),
      }
    },
    err(message) => {
      match tx.rollback() {
        ok => Result::err(message),
        err(rollback_message) => Result::err("{message}; rollback failed: {rollback_message}"),
      }
    },
  }
}

private fn verify_tx(a: app::App, tx: sql::Transaction, token: Str) [Str: Any]!Str {
  let addr = try magic_links::consume_tx(tx, token)
  let user = try users::get_or_create_by_email_tx(tx, addr)
  let session = try sessions::mint_tx(tx, a, user.id)
  try login_attempts::attach_magic_session_tx(tx, token, session.token)
  
  let user_payload: [Str: Any] = [
    "id": user.id,
    "email": user.email,
    "display_name": user.display_name,
  ]
  
  let payload: [Str: Any] = ["session_token": session.token, "user": user_payload]
  
  Result::ok(payload)
}

// Authenticate a request for Dram middleware. Database failures are logged
// server-side and intentionally collapse to an unauthenticated result.
fn authenticate(a: app::App, req: dram::Request) Int? {
  let token = bearer_token(req)
  
  let out = mut Maybe::new<Int>()
  match token.is_empty() {
    true => (),
    false => {
      match sessions::find_by_token(a, token) {
        ok(found) => {
          match found {
            session => out.set(session.user_id),
            _ => (),
          }
        },
        err(message) => fmt::Println("session lookup failed: {message}"),
      }
    },
  }
  out.@
}

struct UserIdKey {
  marker: Int,
}

let USER_ID_KEY = UserIdKey{marker: 0}

fn middleware(a: app::App) dram::Middleware {
  fn(req: dram::Request, res: mut dram::Response, next: dram::Next) {
    match authenticate(a, req) {
      user_id => {
        let derived = context::with_value(req.context, USER_ID_KEY, user_id)
        next.run(req.with_context(derived), res)
      },
      _ => res.json(http::StatusUnauthorized, ["error": "missing, invalid, or expired bearer token"]),
    }
  }
}

fn user_id(req: dram::Request) Int? {
  match context::value(req.context, USER_ID_KEY) {
    value => unsafe::cast<Int>(value),
    _ => Maybe::new(),
  }
}

fn get_user_id(req: dram::Request) Int!Str {
  match user_id(req) {
    id => Result::ok(id),
    _ => Result::err("unauthorized"),
  }
}

// Read a single string field from a JSON request body. All the M2 auth
// bodies are simple `{ "field": "value" }` shapes. Every failure gets
// the same `invalid request:` prefix so clients see a consistent shape.
private fn decode_field(req: dram::Request, name: Str) Str!Str {
  let body = Str::from(req.body)
  match body.is_empty() {
    true => Result::err("empty request body"),
    false => {
      decode::unmarshal(
        body,
        decode::field(name, decode::string),
      ).map_err(fn(e) {
        "invalid request: {e.error()}"
      })
    },
  }
}

// Extract the token from a Bearer Authorization header. Returns "" if
// the header is missing or malformed.
private fn bearer_token(req: dram::Request) Str {
  let auth = req.headers.get("Authorization").or("")
  match auth.starts_with("Bearer ") {
    true => strings::TrimSpace(strings::TrimPrefix(auth, "Bearer ")),
    false => "",
  }
}
