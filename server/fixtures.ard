use ard/list as List

use dram
use go:fmt
use maestro/api_football/fixtures
use maestro/app
use maestro/competitions
use go:net/http
use go:strconv
use go:strings
use go:time

// Public fixture reads proxy API-Football through the shared TTL cache.
// Fixture/team data is not persisted in v1; predictions will store only
// API-Football's stable fixture id.

struct Fixture {
  competition_id: Int,
  fixture: fixtures::Fixture,
}

private fn set_provider_error(res: mut dram::Response, message: Str) {
  fmt::Println("fixture request failed: {message}")
  res.json(http::StatusBadGateway, ["error": "fixture data is temporarily unavailable"])
}

// The "current round" (matchday) of one competition: the round containing
// the earliest fixture that is still to be played. `name` is none when the
// season has no remaining playable fixtures.
struct CurrentRound {
  competition_id: Int?,
  name: Str?,
  fixtures: [Fixture],
}

fn register(router: mut dram::App, a: app::App) {
  router.get("/fixtures/feed", fn(req: dram::Request, res: mut dram::Response) {
    match feed_payload(a) {
      ok(entries) => res.json(http::StatusOK, entries),
      err(message) => set_provider_error(res, message),
    }
  })
  router.get("/fixtures/upcoming", fn(req: dram::Request, res: mut dram::Response) {
    let raw_comp = req.query("competition_id").or("")
    match raw_comp.is_empty() {
      true => {
        match upcoming(a, Maybe::new()) {
          ok(list) => res.json(http::StatusOK, to_json_list(list)),
          err(message) => set_provider_error(res, message),
        }
      },
      false => {
        match strconv::Atoi(raw_comp) {
          ok(id) => {
            match upcoming(a, Maybe::new(id)) {
              ok(list) => res.json(http::StatusOK, to_json_list(list)),
              err(message) => set_provider_error(res, message),
            }
          },
          err(_) => res.json(http::StatusBadRequest, ["error": "competition_id must be an integer"]),
        }
      },
    }
  })
  router.get("/fixtures/round", fn(req: dram::Request, res: mut dram::Response) {
    let raw_name = req.query("name").or("")
    let name: Str? = match raw_name.is_empty() {
      true => Maybe::new(),
      false => Maybe::new(raw_name),
    }
    let raw_comp = req.query("competition_id").or("")
    match raw_comp.is_empty() {
      true => {
        match round_payload(a, Maybe::new(), name) {
          ok(payload) => res.json(http::StatusOK, round_json(payload)),
          err(message) => set_provider_error(res, message),
        }
      },
      false => {
        match strconv::Atoi(raw_comp) {
          ok(id) => {
            match round_payload(a, Maybe::new(id), name) {
              ok(payload) => res.json(http::StatusOK, round_json(payload)),
              err(message) => set_provider_error(res, message),
            }
          },
          err(_) => res.json(http::StatusBadRequest, ["error": "competition_id must be an integer"]),
        }
      },
    }
  })
  router.get("/fixtures/rounds", fn(req: dram::Request, res: mut dram::Response) {
    let raw_comp = req.query("competition_id").or("")
    match raw_comp.is_empty() {
      true => {
        match season_rounds(a, Maybe::new()) {
          ok(payload) => res.json(http::StatusOK, payload),
          err(message) => set_provider_error(res, message),
        }
      },
      false => {
        match strconv::Atoi(raw_comp) {
          ok(id) => {
            match season_rounds(a, Maybe::new(id)) {
              ok(payload) => res.json(http::StatusOK, payload),
              err(message) => set_provider_error(res, message),
            }
          },
          err(_) => res.json(http::StatusBadRequest, ["error": "competition_id must be an integer"]),
        }
      },
    }
  })
  router.get("/fixtures/:id", fn(req: dram::Request, res: mut dram::Response) {
    let raw = req.param("id").or("")
    match strconv::Atoi(raw) {
      ok(id) => {
        match by_id(a, id) {
          ok(found) => {
            match found {
              f => res.json(http::StatusOK, to_json(f)),
              _ => res.json(http::StatusNotFound, ["error": "fixture not found"]),
            }
          },
          err(message) => set_provider_error(res, message),
        }
      },
      err(_) => res.json(http::StatusBadRequest, ["error": "fixture id must be an integer"]),
    }
  })
}

// Fetch all active competitions, optionally selecting one, then filter
// to matches whose kickoff is in the future. API-Football returns a
// season in chronological order; with one active competition (v1), that
// order is preserved. Cross-competition sorting can be added when a
// second competition is activated and the UI establishes the grouping.
fn upcoming(a: app::App, competition_id: Int?) [Fixture]!Str {
  let all = try fetch(a, competition_id)
  let now = time::Now().UnixMilli()
  let out: mut [Fixture] = mut []
  for f in all {
    if f.fixture.kickoff_at >= now {
      out.push(f)
    }
  }
  Result::ok(deref out)
}

// Statuses that mean a fixture will not be played (as scheduled) anymore.
// PST (postponed) is included so a lone rescheduled-but-dateless match
// cannot hijack the current round.
let SETTLED_STATUSES: [Str] = ["FT", "AET", "PEN", "CANC", "ABD", "AWD", "WO", "PST"]

fn is_settled(status: Str) Bool {
  List::contains(SETTLED_STATUSES, fn(s) {
    s == status
  })
}

// A rescheduled fixture can retain its original round even when moved months
// later. Once that round's other fixtures are long finished, the isolated game
// must not drag the matchday navigator back to the historical round.
let MAX_ROUND_SPAN_MS = Int64::from(14 * 24 * 60 * 60 * 1000)

private fn is_detached_reschedule(candidate: fixtures::RoundFixture, list: [fixtures::RoundFixture]) Bool {
  let awaiting_kickoff = candidate.fixture.status == "NS" or candidate.fixture.status == "TBD"
  mut settled_count = 0
  mut playable_count = 0
  mut latest_settled: Int64? = Maybe::new()
  for other in list {
    if other.round == candidate.round {
      match is_settled(other.fixture.status) {
        true => {
          settled_count = settled_count + 1
          match latest_settled {
            kickoff => {
              if other.fixture.kickoff_at > kickoff {
                latest_settled = Maybe::new(other.fixture.kickoff_at)
              }
            },
            _ => { latest_settled = Maybe::new(other.fixture.kickoff_at) },
          }
        },
        false => { playable_count = playable_count + 1 },
      }
    }
  }
  match latest_settled {
    kickoff => {
      let detached = awaiting_kickoff and settled_count > 1 and playable_count == 1 and candidate.fixture.kickoff_at - kickoff > MAX_ROUND_SPAN_MS
      detached
    },
    _ => false,
  }
}

// The round of the earliest fixture that is still playable (not started,
// in play, or awaiting kickoff), excluding detached reschedules from old
// rounds. None when every fixture is settled.
fn pick_round(list: [fixtures::RoundFixture]) Str? {
  mut best_kickoff = Int64::from(0)
  mut best_round: Str? = Maybe::new()
  mut fallback_kickoff = Int64::from(0)
  mut fallback_round: Str? = Maybe::new()
  for f in list {
    if not is_settled(f.fixture.status) {
      match is_detached_reschedule(f, list) {
        true => {
          if fallback_round.is_none() or f.fixture.kickoff_at < fallback_kickoff {
            fallback_kickoff = f.fixture.kickoff_at
            fallback_round = Maybe::new(f.round)
          }
        },
        false => {
          if best_round.is_none() or f.fixture.kickoff_at < best_kickoff {
            best_kickoff = f.fixture.kickoff_at
            best_round = Maybe::new(f.round)
          }
        },
      }
    }
  }
  match best_round {
    round => Maybe::new(round),
    _ => fallback_round,
  }
}

private fn active_competition(a: app::App, competition_id: Int?) Maybe<competitions::Competition>!Str {
  let comps = try competitions::list_active(a)
  mut chosen: competitions::Competition? = Maybe::new()
  for comp in comps {
    let wanted = match competition_id {
      id => id == comp.id,
      _ => chosen.is_none(),
    }
    if wanted {
      chosen = Maybe::new(comp)
    }
  }
  Result::ok(chosen)
}

// Resolve a round for one competition: the requested round name, or the
// current round when unspecified. Uses the same cached season fetch as
// /fixtures/upcoming — no extra upstream call.
fn round_payload(a: app::App, competition_id: Int?, requested: Str?) CurrentRound!Str {
  let chosen = try active_competition(a, competition_id)
  match chosen {
    comp => competition_round(a, comp, requested),
    _ => {
      Result::ok(
        CurrentRound{
          competition_id: Maybe::new(),
          name: Maybe::new(),
          fixtures: [],
        },
      )
    },
  }
}

private fn competition_round(a: app::App, comp: competitions::Competition, requested: Str?) CurrentRound!Str {
  let list = try fixtures::season_round_fixtures(a, comp.api_football_league_id, comp.season)
  let picked: Str? = match requested {
    name => Maybe::new(name),
    _ => pick_round(list),
  }
  match picked {
    name => {
      let out: mut [Fixture] = mut []
      for f in list {
        if f.round == name {
          out.push(Fixture{competition_id: comp.id, fixture: f.fixture})
        }
      }
      Result::ok(
        CurrentRound{
          competition_id: Maybe::new(comp.id),
          name: Maybe::new(name),
          fixtures: deref out,
        },
      )
    },
    _ => {
      Result::ok(
        CurrentRound{
          competition_id: Maybe::new(comp.id),
          name: Maybe::new(),
          fixtures: [],
        },
      )
    },
  }
}

// The unified feed: the current matchday of every active competition in
// one response. Per-competition failures are logged and skipped — one
// flaky upstream league must not blank the whole feed.
fn feed_payload(a: app::App) [Any]!Str {
  let comps = try competitions::list_active(a)
  let out: mut [Any] = mut []
  for comp in comps {
    match competition_round(a, comp, Maybe::new()) {
      ok(round) => {
        let competition: [Str: Any] = [
          "id": comp.id,
          "name": comp.name,
          "api_football_league_id": comp.api_football_league_id,
          "season": comp.season,
        ]
        let entry: [Str: Any] = [
          "competition": competition,
          "round": round.name,
          "fixtures": to_json_list(round.fixtures),
        ]
        out.push(entry)
        ()
      },
      err(message) => fmt::Println("feed: skipping competition {comp.id} ({comp.name}): {message}"),
    }
  }
  Result::ok(deref out)
}

// The trailing integer in a round name like "Regular Season - 28", or a
// large sentinel so unparseable names sort to the end. Regular-season
// rounds all parse; this keeps the picker in numeric order even when the
// upstream fixture array isn't strictly chronological (postponements).
fn round_order_key(name: Str) Int {
  let fields = strings::Fields(name)
  match fields.at(fields.size() - 1) {
    tail => {
      match strconv::Atoi(tail) {
        ok(n) => n,
        err(_) => 1000000,
      }
    },
    _ => 1000000,
  }
}

// Insertion sort by numeric round key (small lists: ~38 rounds).
fn sort_round_names(names: [Str]) [Str] {
  mut out: mut [Str] = mut []
  for name in names {
    let key = round_order_key(name)
    mut inserted = false
    let result: mut [Str] = mut []
    for existing in out {
      let goes_before = (not inserted) and key < round_order_key(existing)
      if goes_before {
        result.push(name)
        inserted = true
      }
      result.push(existing)
    }
    if not inserted {
      result.push(name)
    }
    out = result
  }
  deref out
}

// Every round name in the season, ordered by round number, plus the
// current round.
fn season_rounds(a: app::App, competition_id: Int?) [Str: Any]!Str {
  let chosen = try active_competition(a, competition_id)
  match chosen {
    comp => {
      let list = try fixtures::season_round_fixtures(a, comp.api_football_league_id, comp.season)
      let names: mut [Str] = mut []
      for f in list {
        let seen = List::contains(deref names, fn(name) {
          name == f.round
        })
        if not seen {
          names.push(f.round)
        }
      }
      let ordered = sort_round_names(deref names)
      let rounds: mut [Any] = mut []
      for n in ordered {
        rounds.push(n)
      }
      let payload: [Str: Any] = [
        "competition_id": comp.id,
        "rounds": rounds,
        "current": pick_round(list),
      ]

      Result::ok(payload)
    },
    _ => {
      let empty: [Any] = []
      let no_comp: Int? = Maybe::new()
      let no_round: Str? = Maybe::new()
      let payload: [Str: Any] = ["competition_id": no_comp, "rounds": empty, "current": no_round]
      Result::ok(payload)
    },
  }
}

fn by_id(a: app::App, id: Int) Fixture?!Str {
  let all = try fetch(a, Maybe::new())
  let found = List::find(all, fn(f) {
    f.fixture.id == id
  })
  match found {
    // Not in any active competition's season — e.g. a fixture from a
    // deactivated (finished) season. Resolve it directly upstream so
    // history stays reachable after season rollover.
    fixture => Result::ok(Maybe::new(fixture)),
    _ => by_id_upstream(a, id),
  }
}

private fn by_id_upstream(a: app::App, id: Int) Fixture?!Str {
  let upstream = try fixtures::fixture_by_id(a, id)
  match upstream {
    fixture => {
      let comp = try competitions::find_by_provider_any(a, fixture.api_football_league_id, fixture.season)
      match comp {
        // A fixture from a league we never configured is not ours.
        c => Result::ok(Maybe::new(Fixture{competition_id: c.id, fixture: fixture})),
        _ => Result::ok(Maybe::new()),
      }
    },
    _ => Result::ok(Maybe::new()),
  }
}

private fn fetch(a: app::App, competition_id: Int?) [Fixture]!Str {
  let comps = try competitions::list_active(a)
  let out: mut [Fixture] = mut []
  for comp in comps {
    let include = match competition_id {
      wanted => wanted == comp.id,
      _ => true,
    }
    if include {
      let list = try fixtures::season_fixtures(a, comp.api_football_league_id, comp.season)
      for item in list {
        out.push(Fixture{competition_id: comp.id, fixture: item})
      }
    }
  }
  Result::ok(deref out)
}

private fn round_json(p: CurrentRound) [Str: Any] {
  let payload: [Str: Any] = [
    "competition_id": p.competition_id,
    "round": p.name,
    "fixtures": to_json_list(p.fixtures),
  ]

  payload
}

private fn to_json_list(list: [Fixture]) [Any] {
  let payload: mut [Any] = mut []
  for f in list {
    payload.push(to_json(f))
  }
  deref payload
}

private fn to_json(f: Fixture) [Str: Any] {
  let home_team: [Str: Any] = ["id": f.fixture.home_team_id, "name": f.fixture.home_team_name]

  let away_team: [Str: Any] = ["id": f.fixture.away_team_id, "name": f.fixture.away_team_name]

  let payload: [Str: Any] = [
    "id": f.fixture.id,
    "competition_id": f.competition_id,
    "kickoff_at": f.fixture.kickoff_at,
    "status": f.fixture.status,
    "home_team": home_team,
    "away_team": away_team,
    "home_score": f.fixture.home_score,
    "away_score": f.fixture.away_score,
  ]

  payload
}
