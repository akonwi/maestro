use dram
use go:fmt
use maestro/api_football/details
use maestro/api_football/prematch
use maestro/app
use maestro/strength
use go:net/http
use go:strconv

// Fixture analysis: read-only proxies over API-Football's pre-match
// outlook and post-match detail. Nothing here is persisted; responses
// ride the shared TTL cache in the api_football module.

fn register(router: mut dram::App, a: app::App) {
  router.get("/fixtures/:id/outlook", fn(req: dram::Request, res: mut dram::Response) {
    match strconv::Atoi(req.param("id").or("")) {
      ok(id) => {
        match outlook_payload(a, id) {
          ok(found) => {
            match found {
              payload => res.json(http::StatusOK, payload),
              _ => res.json(http::StatusNotFound, ["error": "no outlook available for this fixture"]),
            }
          },
          err(message) => {
            fmt::Println("fixture outlook failed for fixture {id}: {message}")
            res.json(
              http::StatusBadGateway,
              ["error": "fixture analysis is temporarily unavailable"],
            )
          },
        }
      },
      err(_) => res.json(http::StatusBadRequest, ["error": "fixture id must be an integer"]),
    }
  })
  router.get("/fixtures/:id/match", fn(req: dram::Request, res: mut dram::Response) {
    match strconv::Atoi(req.param("id").or("")) {
      ok(id) => {
        match match_json(a, id) {
          ok(payload) => res.json(http::StatusOK, payload),
          err(message) => {
            fmt::Println("fixture match analysis failed for fixture {id}: {message}")
            res.json(
              http::StatusBadGateway,
              ["error": "fixture analysis is temporarily unavailable"],
            )
          },
        }
      },
      err(_) => res.json(http::StatusBadRequest, ["error": "fixture id must be an integer"]),
    }
  })
}

// ─── JSON shaping ───────────────────────────────────────────────────────

// None when the upstream has no prediction data. Standings and injuries
// are best-effort: a failure leaves them empty rather than failing the
// whole outlook.
fn outlook_payload(a: app::App, fixture_id: Int) Maybe<[Str: Any]>!Str {
  let outlook_opt = try prematch::fixture_outlook(a, fixture_id)
  match outlook_opt {
    outlook => {
      // Each supporting section is best-effort: a failure logs and leaves
      // that section empty rather than failing the whole outlook, so one
      // flaky upstream can't blank out the entire pre-match analysis.
      mut standings: [prematch::StandingRow] = []
      match prematch::league_standings(a, outlook.league_id, outlook.season) {
        ok(v) => { standings = v },
        err(message) => log_section("standings", fixture_id, message),
      }
      mut injuries: [prematch::Injury] = []
      match prematch::fixture_injuries(a, fixture_id) {
        ok(v) => { injuries = v },
        err(message) => log_section("injuries", fixture_id, message),
      }
      let empty_splits = prematch::TeamGoalSplits{
        for_home: "0",
        against_home: "0",
        for_away: "0",
        against_away: "0",
      }

      mut home_splits = empty_splits
      match prematch::team_goal_splits(a, outlook.league_id, outlook.season, outlook.home.id) {
        ok(v) => { home_splits = v },
        err(message) => log_section("home venue splits", fixture_id, message),
      }
      mut away_splits = empty_splits
      match prematch::team_goal_splits(a, outlook.league_id, outlook.season, outlook.away.id) {
        ok(v) => { away_splits = v },
        err(message) => log_section("away venue splits", fixture_id, message),
      }
      mut key_players: [prematch::KeyPlayer] = []
      match prematch::league_key_players(a, outlook.league_id, outlook.season) {
        ok(v) => { key_players = v },
        err(message) => log_section("key players", fixture_id, message),
      }
      mut rankings: [strength::Ranking] = []
      match strength::team_rankings(a, outlook.league_id, outlook.season) {
        ok(v) => { rankings = v },
        err(message) => log_section("strength", fixture_id, message),
      }
      Result::ok(
        Maybe::new(
          outlook_json(
            outlook,
            standings,
            injuries,
            home_splits,
            away_splits,
            key_players,
            rankings,
          ),
        ),
      )
    },
    _ => Result::ok(Maybe::new()),
  }
}

fn outlook_json(
  o: prematch::Outlook,
  standings: [prematch::StandingRow],
  injuries: [prematch::Injury],
  home_splits: prematch::TeamGoalSplits,
  away_splits: prematch::TeamGoalSplits,
  key_players: [prematch::KeyPlayer],
  rankings: [strength::Ranking],
) [Str: Any] {
  let h2h: mut [Any] = mut []
  for m in o.h2h {
    let entry: [Str: Any] = [
      "kickoff_at": m.kickoff_at,
      "home_name": m.home_name,
      "away_name": m.away_name,
      "home_goals": m.home_goals,
      "away_goals": m.away_goals,
    ]

    h2h.push(entry)
  }

  let home_injuries: mut [Any] = mut []
  let away_injuries: mut [Any] = mut []
  for inj in injuries {
    let entry: [Str: Any] = ["player": inj.player, "kind": inj.kind, "reason": inj.reason]
    match inj.team_id == o.home.id {
      true => home_injuries.push(entry),
      false => (),
    }
    match inj.team_id == o.away.id {
      true => away_injuries.push(entry),
      false => (),
    }
  }

  let percent: [Str: Any] = ["home": o.percent_home, "draw": o.percent_draw, "away": o.percent_away]
  let standings_map: [Str: Any] = [
    "home": standing_opt(standings, o.home.id),
    "away": standing_opt(standings, o.away.id),
  ]

  let injuries_map: [Str: Any] = ["home": home_injuries, "away": away_injuries]

  let goals_map: [Str: Any] = [
    "home": team_goals_json(o.home, home_splits, true),
    "away": team_goals_json(o.away, away_splits, false),
  ]

  let home_players: mut [Any] = mut []
  let away_players: mut [Any] = mut []
  for kp in key_players {
    let entry: [Str: Any] = [
      "player_id": kp.player_id,
      "name": kp.name,
      "goals": kp.goals,
      "assists": kp.assists,
      "rating": kp.rating,
      "is_scorer": kp.is_scorer,
      "is_assister": kp.is_assister,
    ]

    match kp.team_id == o.home.id {
      true => home_players.push(entry),
      false => (),
    }
    match kp.team_id == o.away.id {
      true => away_players.push(entry),
      false => (),
    }
  }
  let key_players_map: [Str: Any] = ["home": home_players, "away": away_players]

  let strength_map: [Str: Any] = [
    "home": ranking_opt(rankings, o.home.id),
    "away": ranking_opt(rankings, o.away.id),
    "total": rankings.size(),
  ]

  let payload: [Str: Any] = [
    "percent": percent,
    "home": team_outlook_json(o.home),
    "away": team_outlook_json(o.away),
    "h2h": h2h,
    "standings": standings_map,
    "injuries": injuries_map,
    "goals": goals_map,
    "key_players": key_players_map,
    "strength": strength_map,
  ]

  payload
}

private fn log_section(section: Str, fixture_id: Int, message: Str) {
  fmt::Println("outlook: {section} failed for fixture {fixture_id}: {message}")
}

private fn ranking_opt(rankings: [strength::Ranking], team_id: Int) Maybe<[Str: Any]> {
  match strength::find_ranking(rankings, team_id) {
    r => {
      let entry: [Str: Any] = ["ppg": r.ppg, "rank": r.rank, "games": r.games]
      Maybe::new(entry)
    },
    _ => Maybe::new(),
  }
}

private fn team_goals_json(
  t: prematch::TeamOutlook,
  splits: prematch::TeamGoalSplits,
  is_home: Bool,
) [Str: Any] {
  let venue_for = match is_home {
    true => splits.for_home,
    false => splits.for_away,
  }
  let venue_against = match is_home {
    true => splits.against_home,
    false => splits.against_away,
  }
  let season: [Str: Any] = ["for": t.goals_for_avg, "against": t.goals_against_avg]
  let venue: [Str: Any] = ["for": venue_for, "against": venue_against]
  let last5: [Str: Any] = ["for": t.last5_for_avg, "against": t.last5_against_avg]
  let payload: [Str: Any] = ["season": season, "venue": venue, "last5": last5]
  payload
}

private fn standing_opt(standings: [prematch::StandingRow], team_id: Int) Maybe<[Str: Any]> {
  mut found: Maybe<[Str: Any]> = Maybe::new()
  for row in standings {
    match row.team_id == team_id {
      true => {
        let entry: [Str: Any] = [
          "rank": row.rank,
          "points": row.points,
          "goals_diff": row.goals_diff,
          "group": row.group,
        ]

        found = Maybe::new(entry)
      },
      false => (),
    }
  }
  found
}

private fn team_outlook_json(t: prematch::TeamOutlook) [Str: Any] {
  let payload: [Str: Any] = [
    "id": t.id,
    "name": t.name,
    "form": t.form,
    "goals_for_avg": t.goals_for_avg,
    "goals_against_avg": t.goals_against_avg,
    "goals_for_total": t.goals_for_total,
    "goals_against_total": t.goals_against_total,
    "wins": t.wins,
    "draws": t.draws,
    "losses": t.losses,
    "home_wins": t.home_wins,
    "home_draws": t.home_draws,
    "home_losses": t.home_losses,
    "away_wins": t.away_wins,
    "away_draws": t.away_draws,
    "away_losses": t.away_losses,
    "clean_sheets": t.clean_sheets,
  ]

  payload
}

// Each section degrades independently: a failed or partially populated
// upstream section becomes an empty list instead of failing the whole
// response. Only when every section errors do we surface a failure.
fn match_json(a: app::App, fixture_id: Int) [Str: Any]!Str {
  mut failures = 0
  mut last_error = ""

  mut stats: [details::TeamStats] = []
  match details::fixture_statistics(a, fixture_id) {
    ok(v) => { stats = v },
    err(message) => {
      failures = failures + 1
      last_error = message
    },
  }
  mut events: [details::MatchEvent] = []
  match details::fixture_events(a, fixture_id) {
    ok(v) => { events = v },
    err(message) => {
      failures = failures + 1
      last_error = message
    },
  }
  mut lineups: [details::Lineup] = []
  match details::fixture_lineups(a, fixture_id) {
    ok(v) => { lineups = v },
    err(message) => {
      failures = failures + 1
      last_error = message
    },
  }
  mut players: [details::TeamPlayers] = []
  match details::fixture_players(a, fixture_id) {
    ok(v) => { players = v },
    err(message) => {
      failures = failures + 1
      last_error = message
    },
  }

  try require_some_section(failures, last_error)

  let stats_json: mut [Any] = mut []
  for t in stats {
    let lines: mut [Any] = mut []
    for s in t.stats {
      let line: [Str: Any] = ["label": s.label, "value": s.value]
      lines.push(line)
    }
    let entry: [Str: Any] = ["team_id": t.team_id, "team_name": t.team_name, "stats": lines]
    stats_json.push(entry)
  }

  let events_json: mut [Any] = mut []
  for e in events {
    let entry: [Str: Any] = [
      "minute": e.minute,
      "extra": e.extra,
      "team_id": e.team_id,
      "kind": e.kind,
      "detail": e.detail,
      "player": e.player,
      "assist": e.assist,
      "comments": e.comments,
    ]

    events_json.push(entry)
  }

  let lineups_json: mut [Any] = mut []
  for l in lineups {
    let entry: [Str: Any] = [
      "team_id": l.team_id,
      "team_name": l.team_name,
      "formation": l.formation,
      "coach": l.coach,
      "color_primary": l.color_primary,
      "color_number": l.color_number,
      "starters": lineup_players_json(l.starters),
      "bench": lineup_players_json(l.bench),
    ]

    lineups_json.push(entry)
  }

  let players_json: mut [Any] = mut []
  for t in players {
    let lines: mut [Any] = mut []
    for p in t.players {
      let line: [Str: Any] = [
        "id": p.id,
        "name": p.name,
        "position": p.position,
        "rating": p.rating,
        "minutes": p.minutes,
        "goals": p.goals,
        "assists": p.assists,
        "saves": p.saves,
        "shots": p.shots,
        "shots_on": p.shots_on,
        "passes": p.passes,
        "key_passes": p.key_passes,
        "tackles": p.tackles,
        "duels": p.duels,
        "duels_won": p.duels_won,
        "dribbles_attempted": p.dribbles_attempted,
        "dribbles_won": p.dribbles_won,
        "yellow": p.yellow,
        "red": p.red,
      ]

      lines.push(line)
    }
    let entry: [Str: Any] = ["team_id": t.team_id, "team_name": t.team_name, "players": lines]
    players_json.push(entry)
  }

  let payload: [Str: Any] = [
    "statistics": stats_json,
    "events": events_json,
    "lineups": lineups_json,
    "players": players_json,
  ]

  Result::ok(payload)
}

private fn require_some_section(failures: Int, last_error: Str) Void!Str {
  match failures == 4 {
    true => Result::err(last_error),
    false => Result::ok(()),
  }
}

private fn lineup_players_json(list: [details::LineupPlayer]) [Any] {
  let out: mut [Any] = mut []
  for p in list {
    let entry: [Str: Any] = [
      "id": p.id,
      "name": p.name,
      "number": p.number,
      "pos": p.pos,
      "grid": p.grid,
    ]

    out.push(entry)
  }
  deref out
}
