#!/usr/bin/env bash
set -euo pipefail

GO_VERSION="1.26.5"
GOPLS_VERSION="v0.23.0"
ARD_VERSION="v0.36.0"
MIGR_VERSION="v0.1.1"
BUN_VERSION="1.3.10"
NODE_VERSION="24.19.0"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="${HOME}/.local/bin"
TOOLS_DIR="${HOME}/.local/share"
GO_DIR="${TOOLS_DIR}/go-${GO_VERSION}"
ARD_DIR="${TOOLS_DIR}/ard-${ARD_VERSION}"
MIGR_DIR="${TOOLS_DIR}/migr-${MIGR_VERSION}"
BUN_DIR="${TOOLS_DIR}/bun-${BUN_VERSION}"
NODE_DIR="${TOOLS_DIR}/node-${NODE_VERSION}"

case "$(uname -m)" in
  x86_64)
    GO_ARCH="amd64"
    GO_SHA256="5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053"
    ARD_SHA256="f32481308905730e16d11174ba4516b44ca38a005359a6765fef12180ed00f5f"
    MIGR_SHA256="05d693b8de1ede54db6c80032b07a691994003cfc5fef6c4cd453bf73f220e17"
    BUN_ARCH="x64"
    BUN_SHA256="f57bc0187e39623de716ba3a389fda5486b2d7be7131a980ba54dc7b733d2e08"
    NODE_ARCH="x64"
    NODE_SHA256="14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647"
    ;;
  aarch64|arm64)
    GO_ARCH="arm64"
    GO_SHA256="fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49"
    ARD_SHA256="4502044dc74c51b4678a63ab044919c4c0506c3cb303c251cf335bd4dfd885dc"
    MIGR_SHA256="49328783ed5fa126554e422cdd04cb90081ba3111baedea39c960af07fae7da3"
    BUN_ARCH="aarch64"
    BUN_SHA256="fa5ecb25cafa8e8f5c87a0f833719d46dd0af0a86c7837d806531212d55636d3"
    NODE_ARCH="arm64"
    NODE_SHA256="01443c1e1a29e531ccad5a46fefa6df490d2189c49f7955904aecdbb0fe86fdc"
    ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

missing_packages=()
command -v cc >/dev/null 2>&1 || missing_packages+=(build-essential)
command -v curl >/dev/null 2>&1 || missing_packages+=(curl)
command -v git >/dev/null 2>&1 || missing_packages+=(git)
command -v unzip >/dev/null 2>&1 || missing_packages+=(unzip)
command -v xz >/dev/null 2>&1 || missing_packages+=(xz-utils)
if ! dpkg-query -W -f='${Status}' ca-certificates 2>/dev/null | grep -Fq "install ok installed"; then
  missing_packages+=(ca-certificates)
fi

if ((${#missing_packages[@]})); then
  echo "==> Installing system packages: ${missing_packages[*]}"
  time sudo env DEBIAN_FRONTEND=noninteractive apt-get update
  time sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
fi

mkdir -p "${BIN_DIR}" "${TOOLS_DIR}"
export PATH="${BIN_DIR}:${PATH}"

profile_marker="# Maestro orb toolchain"
if ! grep -Fqx "${profile_marker}" "${HOME}/.bash_profile" 2>/dev/null; then
  cat >> "${HOME}/.bash_profile" <<'EOF'

# Maestro orb toolchain
case ":${PATH}:" in
  *:"${HOME}/.local/bin":*) ;;
  *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac
EOF
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT

download_and_verify() {
  local url="$1"
  local destination="$2"
  local checksum="$3"

  curl --fail --location --retry 3 --output "${destination}" "${url}"
  echo "${checksum}  ${destination}" | sha256sum --check --status
}

if ! "${GO_DIR}/bin/go" version 2>/dev/null | grep -Fq "go${GO_VERSION}"; then
  echo "==> Installing Go ${GO_VERSION} for linux/${GO_ARCH}"
  go_archive="${tmp_dir}/go.tar.gz"
  time download_and_verify \
    "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" \
    "${go_archive}" \
    "${GO_SHA256}"
  tar -xzf "${go_archive}" -C "${tmp_dir}"
  rm -rf "${GO_DIR}"
  mv "${tmp_dir}/go" "${GO_DIR}"
else
  echo "==> Go ${GO_VERSION} is already installed"
fi
ln -sfn "${GO_DIR}/bin/go" "${BIN_DIR}/go"
ln -sfn "${GO_DIR}/bin/gofmt" "${BIN_DIR}/gofmt"

if [[ "$("${ARD_DIR}/ard" version 2>/dev/null || true)" != "${ARD_VERSION}" ]]; then
  echo "==> Installing Ard ${ARD_VERSION} for linux/${GO_ARCH}"
  ard_archive="${tmp_dir}/ard.tar.gz"
  time download_and_verify \
    "https://github.com/akonwi/ard/releases/download/${ARD_VERSION}/ard_${ARD_VERSION}_linux_${GO_ARCH}.tar.gz" \
    "${ard_archive}" \
    "${ARD_SHA256}"
  rm -rf "${ARD_DIR}"
  mkdir -p "${ARD_DIR}"
  tar -xzf "${ard_archive}" -C "${ARD_DIR}"
else
  echo "==> Ard ${ARD_VERSION} is already installed"
fi
ln -sfn "${ARD_DIR}/ard" "${BIN_DIR}/ard"

if [[ ! -x "${MIGR_DIR}/migr" ]]; then
  echo "==> Installing migr ${MIGR_VERSION} for linux/${GO_ARCH}"
  migr_archive="${tmp_dir}/migr.tar.gz"
  time download_and_verify \
    "https://github.com/akonwi/migr/releases/download/${MIGR_VERSION}/migr-linux-${GO_ARCH}.tar.gz" \
    "${migr_archive}" \
    "${MIGR_SHA256}"
  rm -rf "${MIGR_DIR}"
  mkdir -p "${MIGR_DIR}"
  tar -xzf "${migr_archive}" -C "${MIGR_DIR}"
else
  echo "==> migr ${MIGR_VERSION} is already installed"
fi
ln -sfn "${MIGR_DIR}/migr" "${BIN_DIR}/migr"

if [[ "$(bun --version 2>/dev/null || true)" != "${BUN_VERSION}" ]]; then
  echo "==> Installing Bun ${BUN_VERSION} for linux/${BUN_ARCH}"
  bun_archive="${tmp_dir}/bun.zip"
  time download_and_verify \
    "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${BUN_ARCH}.zip" \
    "${bun_archive}" \
    "${BUN_SHA256}"
  rm -rf "${BUN_DIR}"
  mkdir -p "${BUN_DIR}"
  unzip -q "${bun_archive}" -d "${tmp_dir}/bun"
  mv "${tmp_dir}/bun/bun-linux-${BUN_ARCH}/bun" "${BUN_DIR}/bun"
  chmod +x "${BUN_DIR}/bun"
  ln -sfn "${BUN_DIR}/bun" "${BIN_DIR}/bun"
else
  echo "==> Bun ${BUN_VERSION} is already installed"
fi

if [[ "$("${NODE_DIR}/bin/node" --version 2>/dev/null || true)" != "v${NODE_VERSION}" ]]; then
  echo "==> Installing Node.js ${NODE_VERSION} for linux/${NODE_ARCH}"
  node_archive="${tmp_dir}/node.tar.xz"
  time download_and_verify \
    "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
    "${node_archive}" \
    "${NODE_SHA256}"
  rm -rf "${NODE_DIR}"
  tar -xJf "${node_archive}" -C "${tmp_dir}"
  mv "${tmp_dir}/node-v${NODE_VERSION}-linux-${NODE_ARCH}" "${NODE_DIR}"
else
  echo "==> Node.js ${NODE_VERSION} is already installed"
fi
for node_tool in node npm npx corepack; do
  ln -sfn "${NODE_DIR}/bin/${node_tool}" "${BIN_DIR}/${node_tool}"
done

if ! gopls version 2>/dev/null | grep -Fq "${GOPLS_VERSION}"; then
  echo "==> Installing gopls ${GOPLS_VERSION}"
  time GOBIN="${BIN_DIR}" go install "golang.org/x/tools/gopls@${GOPLS_VERSION}"
else
  echo "==> gopls ${GOPLS_VERSION} is already installed"
fi

echo "==> Downloading server Go modules"
time (
  cd "${REPO_ROOT}/server"
  go mod download
)

echo "==> Fetching server Ard dependencies"
time (
  cd "${REPO_ROOT}/server"
  ard deps fetch
)

echo "==> Installing server test dependencies"
time (
  cd "${REPO_ROOT}/server"
  bun install --frozen-lockfile
)

echo "==> Installing web dependencies"
time (
  cd "${REPO_ROOT}/web"
  bun install --frozen-lockfile
)

echo "==> Orb setup complete"
go version
ard version
printf 'Bun %s\n' "$(bun --version)"
node --version
gopls version
printf 'migr %s installed at %s\n' "${MIGR_VERSION}" "$(command -v migr)"
